{
  "name": "@agentix/nexus-chatgpt-app",
  "version": "0.1.0",
  "private": true,
  "description": "Agentix Nexus ChatGPT App — MCP-based agentic shopping App with inline UI for ChatGPT (and any MCP-compatible host)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:http": "tsx watch src/server.ts --transport=http",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --transport=http",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@agentix/nexus-sdk": "file:../nexus-sdk",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=20" }
}
