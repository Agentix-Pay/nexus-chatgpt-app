# ── Nexus API access ────────────────────────────────────────────────
NEXUS_BASE_URL=https://agentix-nexus.fly.dev

# Per-shopper-session: in production these come from the JWT issued by Nexus's
# OAuth provider (Cognito). For local dev with the stub OAuth: a manually-issued
# JWT works. NEXUS_FALLBACK_API_KEY is used for unauthenticated tool calls
# (browse / search) — same as the Custom GPT's API key today.
NEXUS_FALLBACK_API_KEY=

# ── ChatGPT App identity ────────────────────────────────────────────
# These are issued by OpenAI when you register the App with their platform.
CHATGPT_APP_CLIENT_ID=
CHATGPT_APP_CLIENT_SECRET=

# ── Server ──────────────────────────────────────────────────────────
PORT=4400
NODE_ENV=development
